<!DOCTYPE html>
<html>
  <head>
    <!-- Served as a template (linkTextsWithSefaria) so it can share the
         insertion options with the sidebar's Layout tray. -->
    <?!= include('shared/ui/head'); ?>
    <?!= include('shared/css/native-controls'); ?>
    <?!= include('css/tokens'); ?>
    <?!= include('shared/insertion-options/css'); ?>
    <?!= include('shared/composition-card/css'); ?>
    <style>
      :root {
        --bg: #f5f5f3;
        --panel: #ffffff;
        --border: #d4d0ca;
        --text: #222222;
        --muted: #666666;
        --blue: #1f3b68;
        --blue-soft: #eef3fb;
        --amber: #8a5300;
        --amber-soft: #fcf3e3;
        --radius: 10px;
      }

      *, *::before, *::after { box-sizing: border-box; }

      /* The four dialog states are toggled with the `hidden` attribute, but
         several of them also carry `display: flex`, which beats the browser's
         own [hidden] rule. Without this every state rendered at once: the
         scanning bar, the review table, "Applying links" and the Close button
         stacked in one column, with the table squeezed between them. */
      [hidden] { display: none !important; }

      body {
        margin: 0;
        background: var(--bg);
        color: var(--text);
        font-family: system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", Arial, sans-serif;
        font-size: 14px;
        line-height: 1.5;
      }

      main {
        display: flex;
        flex-direction: column;
        height: 100vh;
        padding: 16px 20px 12px;
      }

      h2 {
        margin: 0 0 4px;
        font-size: 16px;
        font-weight: 600;
        color: var(--blue);
      }

      .helper {
        margin: 0 0 10px;
        color: var(--muted);
        font-size: 13px;
      }

      .summary-line {
        margin: 0 0 10px;
        padding: 8px 12px;
        background: var(--blue-soft);
        border: 1px solid var(--border);
        border-radius: var(--radius);
        font-size: 13px;
      }
      .summary-line.has-warning {
        background: var(--amber-soft);
      }

      #state-review {
        flex: 1;
        display: flex;
        flex-direction: column;
        min-height: 0;
      }

      .controls-row {
        display: flex;
        align-items: center;
        gap: 8px;
        margin-bottom: 8px;
      }

      .selection-count {
        margin-left: auto;
        font-size: 12px;
        color: var(--muted);
      }

      .table-scroll {
        flex: 1;
        overflow-y: auto;
        border: 1px solid var(--border);
        border-radius: var(--radius);
        background: var(--panel);
        /* Room for a few rows even with "Customize this insertion" open. */
        min-height: 130px;
      }

      table {
        width: 100%;
        border-collapse: collapse;
      }

      thead th {
        position: sticky;
        top: 0;
        z-index: 1;
        background: var(--panel);
        border-bottom: 1px solid var(--border);
        text-align: left;
        padding: 8px 10px;
        font-size: 12px;
        font-weight: 600;
        color: var(--muted);
      }

      tbody td {
        padding: 8px 10px;
        border-bottom: 1px solid #ededea;
        vertical-align: top;
      }
      tbody tr:last-child td { border-bottom: none; }

      tbody tr.is-ambiguous { background: var(--amber-soft); }

      th.cb-col, td.cb-cell {
        width: 54px;
        text-align: center;
      }
      th.cb-col label {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 2px;
        cursor: pointer;
      }

      tr.group-row td {
        padding: 0;
        background: #f7f6f3;
      }
      .group-toggle {
        display: block;
        width: 100%;
        padding: 7px 10px;
        border: none;
        background: none;
        text-align: left;
        font-size: 12px;
        font-family: inherit;
        color: var(--blue);
        cursor: pointer;
      }
      .group-toggle:hover { text-decoration: underline; }

      .doc-text {
        font-weight: 600;
        word-break: break-word;
      }

      .snippet {
        display: block;
        margin-top: 2px;
        font-weight: 400;
        font-size: 12px;
        color: var(--muted);
      }

      td.ref-cell { width: 46%; }

      select.ref-select {
        width: 100%;
        max-width: 100%;
        padding: 4px 6px;
        border: 1px solid var(--border);
        border-radius: 6px;
        background: #fff;
        font-size: 13px;
        font-family: inherit;
      }

      .single-ref {
        font-size: 13px;
        word-break: break-word;
      }

      .ambiguous-tag {
        display: inline-block;
        margin-bottom: 4px;
        padding: 1px 6px;
        border-radius: 999px;
        background: var(--amber);
        color: #fff;
        font-size: 11px;
        font-weight: 600;
      }

      .preview {
        display: block;
        margin-top: 4px;
        font-size: 12px;
        color: var(--muted);
        line-height: 1.4;
      }

      .actions {
        display: flex;
        justify-content: flex-end;
        gap: 8px;
        padding-top: 12px;
      }

      .btn {
        padding: 7px 14px;
        border: 1px solid var(--border);
        border-radius: 8px;
        background: #fff;
        color: var(--text);
        font-size: 13px;
        font-family: inherit;
        cursor: pointer;
      }
      .btn:hover { background: #f0efec; }
      .btn:disabled { opacity: 0.5; cursor: default; }

      .btn-primary {
        background: var(--blue);
        border-color: var(--blue);
        color: #fff;
      }
      .btn-primary:hover { background: #2a4d85; }

      .progress-label { margin: 0 0 8px; font-size: 14px; }
      .progress-track {
        height: 8px;
        border-radius: 999px;
        background: #e4e2de;
        overflow: hidden;
      }
      .progress-fill {
        height: 100%;
        width: 0;
        background: var(--blue);
        transition: width 0.18s ease;
      }
      .progress-track.is-indeterminate .progress-fill {
        width: 40%;
        animation: slide 1.1s ease-in-out infinite;
      }
      @keyframes slide {
        0%   { margin-left: -40%; }
        100% { margin-left: 100%; }
      }
      @media (prefers-reduced-motion: reduce) {
        .progress-track.is-indeterminate .progress-fill {
          animation: none;
          width: 100%;
          opacity: 0.4;
        }
        .progress-fill { transition: none; }
      }
      .progress-detail { margin: 8px 0 0; font-size: 12px; color: var(--muted); }

      .centered-state {
        flex: 1;
        display: flex;
        flex-direction: column;
        justify-content: center;
      }

      /* "Customize this insertion": the sidebar's Layout tray controls
         (shared/insertion-options + the composition card), for this pass only. */
      .customize-insertion {
        margin-top: 10px;
        border: 1px solid var(--border);
        border-radius: var(--radius);
        background: var(--panel);
      }
      .customize-insertion > summary {
        display: flex;
        align-items: center;
        gap: 8px;
        padding: 8px 12px;
        cursor: pointer;
        font-size: 13px;
        font-weight: 600;
        color: var(--blue);
        list-style: none;
      }
      .customize-insertion > summary::-webkit-details-marker { display: none; }
      .customize-insertion > summary::before {
        content: "▸";
        font-size: 11px;
        color: var(--muted);
      }
      .customize-insertion[open] > summary::before { content: "▾"; }
      .customize-state {
        margin-left: auto;
        font-size: 12px;
        font-weight: 400;
        color: var(--muted);
      }
      .customize-insertion.is-customized .customize-state {
        color: var(--amber);
        font-weight: 600;
      }
      .customize-body {
        max-height: min(240px, 38vh);
        overflow-y: auto;
        padding: 0 12px 12px;
        border-top: 1px solid #ededea;
      }
      .customize-body .helper { margin: 8px 0 10px; }
      .customize-grid {
        display: grid;
        grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
        gap: 14px;
        align-items: start;
      }
      .customize-section {
        display: flex;
        flex-direction: column;
        gap: 6px;
        min-width: 0;
      }
      .customize-section-label {
        font-size: 10px;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        color: var(--muted);
      }
      .customize-section .cc-card { margin: 0; }
      .customize-check {
        display: flex;
        align-items: flex-start;
        gap: 8px;
        margin-top: 6px;
        font-size: 13px;
        cursor: pointer;
      }
      .customize-check input { margin-top: 3px; }
      .customize-check small {
        display: block;
        color: var(--muted);
        font-size: 12px;
      }
      .customize-actions {
        display: flex;
        gap: 8px;
        margin-top: 10px;
      }
      .customize-actions .btn { padding: 4px 10px; font-size: 12px; }

      .done-message { margin: 0 0 14px; font-size: 14px; white-space: pre-line; }
      .error-message { color: #a32017; }
    </style>
  </head>
  <body>
    <main>

      <div id="state-scanning" class="centered-state">
        <p class="progress-label" id="scan-label">Scanning the document for Sefaria references…</p>
        <div class="progress-track is-indeterminate"><div class="progress-fill"></div></div>
        <p class="progress-detail">This can take a few seconds. You can keep this dialog open.</p>
      </div>

      <div id="state-review" hidden>
        <h2 id="review-title">Review references</h2>
        <p class="helper" id="review-helper"></p>
        <p class="summary-line" id="summary-line" hidden></p>

        <div class="controls-row" id="review-controls">
          <span class="selection-count" id="selection-count"></span>
        </div>

        <div class="table-scroll">
          <table>
            <thead>
              <tr>
                <th class="cb-col"><label>Link <input type="checkbox" id="master-link-cb" title="Link all"></label></th>
                <th class="cb-col"><label>Insert <input type="checkbox" id="master-insert-cb" title="Insert all"></label></th>
                <th>Text in your document</th>
                <th>Source</th>
              </tr>
            </thead>
            <tbody id="matches-tbody"></tbody>
            <tbody id="group-toggle-tbody" hidden>
              <tr class="group-row">
                <td colspan="4"><button type="button" class="group-toggle" id="group-toggle-btn" aria-expanded="false" aria-controls="confident-tbody"></button></td>
              </tr>
            </tbody>
            <tbody id="confident-tbody"></tbody>
          </table>
        </div>

        <details class="customize-insertion" id="customize-insertion" hidden>
          <summary>📰 Customize this insertion <span class="customize-state" id="customize-state">Your defaults</span></summary>
          <div class="customize-body">
            <p class="helper">Applies to the sources you tick Insert for, this time only. Your defaults in Preferences don’t change unless you save them.</p>
            <div class="customize-grid" id="customize-root">
              <div class="customize-section">
                <div class="customize-section-label">Display &amp; Layout</div>
                <?!= include('shared/insertion-options/markup') ?>
                <label class="customize-check">
                  <input type="checkbox" id="customize-replace">
                  <span>Replace a citation on its own line<small>The inserted source takes its place, titled with the citation. A citation inside a sentence always stays.</small></span>
                </label>
              </div>
              <div class="customize-section">
                <div class="customize-section-label">Insertion Format</div>
                <div class="cc-card cc-card--stacked" id="composition-card-container" data-cc-features="linkedTitle,secondaryPills" aria-label="Composition for these insertions">
                  <?!= include('shared/composition-card/markup') ?>
                </div>
              </div>
            </div>
            <div class="customize-actions">
              <button type="button" class="btn" id="customize-revert" disabled>&#x21BA; Revert to defaults</button>
              <button type="button" class="btn" id="customize-save" disabled>&#x1F4BE; Save as defaults</button>
            </div>
          </div>
        </details>

        <div class="actions">
          <button type="button" class="btn" id="cancel-btn">Cancel</button>
          <button type="button" class="btn btn-primary" id="apply-btn">Apply</button>
        </div>
      </div>

      <div id="state-applying" class="centered-state" hidden>
        <p class="progress-label" id="apply-label">Applying links…</p>
        <div class="progress-track"><div class="progress-fill" id="apply-fill"></div></div>
        <p class="progress-detail" id="apply-detail"></p>
      </div>

      <div id="state-done" class="centered-state" hidden>
        <p class="done-message" id="done-message"></p>
        <div class="actions">
          <button type="button" class="btn btn-primary" id="done-close-btn">Close</button>
        </div>
      </div>

    </main>

    <?!= include('shared/insertion-options/js'); ?>
    <?!= include('shared/composition-card/shared'); ?>
    <script>
      (function () {
        // Every cell below is built with createElement + textContent. The data
        // is Sefaria text and the reader's own document, and this dialog has no
        // innerHTML sink at all — keep it that way.
        var report = null;
        // One entry per match: {match, linkCb, insertCb, select}. Link and
        // Insert are independent, so a row can be linked, inserted, both, or
        // neither (skipped).
        var rows = [];
        // Apply-time outcomes the done message reports.
        var missingCount = 0;
        var notices = [];
        function addNotice(text) {
          if (text && notices.indexOf(text) < 0) notices.push(text);
        }

        function byId(id) { return document.getElementById(id); }

        function showState(name) {
          ['scanning', 'review', 'applying', 'done'].forEach(function (state) {
            byId('state-' + state).hidden = (state !== name);
          });
        }

        function plural(n, singular, pluralForm) {
          return n + ' ' + (n === 1 ? singular : (pluralForm || singular + 's'));
        }

        // ---- customize this insertion -----------------------------------------
        //
        // The sidebar's Layout tray controls, for the sources this pass inserts.
        // `defaults` is the stored preferences, `custom` what the panel shows;
        // both use preference keys and the string values UserProperties holds,
        // so the overrides sent with each insert are just the keys that differ.
        // Read the way the server reads them (buildLinkSourcesInsertOptions_):
        // only "true" turns on Lines, Sources, the linked title and
        // transliteration; only "false" turns off vowels, cantillation and
        // replacing the citation.
        var defaults = null;
        var custom = null;
        var INSERT_PREF_KEYS = [
          'output_mode_default', 'bilingual_layout_default', 'source_emphasis_mode',
          'transliteration_scheme', 'nekudot', 'teamim', 'include_transliteration_default',
          'show_line_markers_default', 'include_translation_source_info',
          'insert_sefaria_link_default', 'insert_from_selection_replace'
        ];
        var ON_UNLESS_FALSE = ['nekudot', 'teamim', 'insert_from_selection_replace'];
        var ON_IF_TRUE = ['include_transliteration_default', 'show_line_markers_default',
          'include_translation_source_info', 'insert_sefaria_link_default'];

        function oneOf(value, allowed) {
          return allowed.indexOf(value) >= 0 ? value : allowed[0];
        }

        function normalizeInsertPrefs(prefs) {
          var text = function (key) { return prefs && prefs[key] != null ? String(prefs[key]) : ''; };
          var out = {
            output_mode_default: oneOf(text('output_mode_default'), ['both', 'en', 'he']),
            bilingual_layout_default: oneOf(text('bilingual_layout_default'), ['he-right', 'he-left', 'he-top']),
            source_emphasis_mode: ccNormalizeEmphasisMode(text('source_emphasis_mode')),
            transliteration_scheme: text('transliteration_scheme') || 'traditional'
          };
          ON_UNLESS_FALSE.forEach(function (key) { out[key] = text(key) === 'false' ? 'false' : 'true'; });
          ON_IF_TRUE.forEach(function (key) { out[key] = text(key) === 'true' ? 'true' : 'false'; });
          return out;
        }

        function changedInsertPrefs() {
          var changed = {};
          if (!defaults || !custom) return changed;
          INSERT_PREF_KEYS.forEach(function (key) {
            if (custom[key] !== defaults[key]) changed[key] = custom[key];
          });
          return changed;
        }

        function flip(key) { custom[key] = custom[key] === 'true' ? 'false' : 'true'; }

        function refreshCustomizeState() {
          var isCustomized = Object.keys(changedInsertPrefs()).length > 0;
          byId('customize-insertion').classList.toggle('is-customized', isCustomized);
          byId('customize-state').textContent = isCustomized ? 'Customized for this pass' : 'Your defaults';
          byId('customize-revert').disabled = !isCustomized;
          byId('customize-save').disabled = !isCustomized;
          byId('customize-replace').checked = custom.insert_from_selection_replace === 'true';
        }

        function refreshCustomize() {
          updateInsertionOptions();
          updateCompositionCard();
        }

        function setupCustomize(prefs) {
          defaults = normalizeInsertPrefs(prefs);
          custom = Object.assign({}, defaults);

          initInsertionOptions({
            root: '#customize-root',
            getState: function () {
              return { outputMode: custom.output_mode_default, layout: custom.bilingual_layout_default };
            },
            onSelectDisplay: function (mode) { custom.output_mode_default = mode; refreshCustomizeState(); },
            onSelectLayout: function (layout) { custom.bilingual_layout_default = layout; refreshCustomizeState(); }
          });

          initCompositionCard({
            containerId: 'composition-card-container',
            getState: function () {
              return {
                vowelsOn: custom.nekudot === 'true',
                cantillationOn: custom.teamim === 'true',
                transliterationOn: custom.include_transliteration_default === 'true',
                scheme: custom.transliteration_scheme,
                linkOn: custom.insert_sefaria_link_default === 'true',
                linesOn: custom.show_line_markers_default === 'true',
                detailsOn: custom.include_translation_source_info === 'true',
                emphasisMode: custom.source_emphasis_mode
              };
            },
            onToggle: function (key) {
              if (key === 'vowels') flip('nekudot');
              else if (key === 'cantillation') flip('teamim');
              else if (key === 'translit') flip('include_transliteration_default');
              else if (key === 'link') flip('insert_sefaria_link_default');
              else if (key === 'lines') flip('show_line_markers_default');
              else if (key === 'details') flip('include_translation_source_info');
              else if (key === 'emphasis') custom.source_emphasis_mode = ccNextEmphasisMode(custom.source_emphasis_mode);
            },
            onSchemeSelect: function (value) {
              if (value === 'none') {
                custom.include_transliteration_default = 'false';
              } else {
                custom.include_transliteration_default = 'true';
                custom.transliteration_scheme = value;
              }
            },
            afterUpdate: refreshCustomizeState
          });

          byId('customize-replace').addEventListener('change', function () {
            custom.insert_from_selection_replace = this.checked ? 'true' : 'false';
            refreshCustomizeState();
          });
          byId('customize-revert').addEventListener('click', function () {
            custom = Object.assign({}, defaults);
            refreshCustomize();
          });
          byId('customize-save').addEventListener('click', function () {
            var button = this;
            var label = button.textContent;
            var changed = changedInsertPrefs();
            button.disabled = true;
            button.textContent = 'Saving…';
            google.script.run
              .withSuccessHandler(function () {
                defaults = Object.assign({}, custom);
                button.textContent = label;
                refreshCustomize();
              })
              .withFailureHandler(function () {
                button.textContent = 'Could not save — try again';
                button.disabled = false;
              })
              .setPreferences(changed);
          });

          refreshCustomize();
          byId('customize-insertion').hidden = false;
        }

        // The panel needs the stored defaults to start from. If they can't be
        // read it stays hidden, and inserts use the stored defaults anyway.
        google.script.run
          .withSuccessHandler(setupCustomize)
          .withFailureHandler(function () {})
          .getPreferences();

        // ---- scan -----------------------------------------------------------

        google.script.run
          .withSuccessHandler(onScanned)
          .withFailureHandler(function (error) {
            showState('done');
            var message = byId('done-message');
            message.classList.add('error-message');
            message.textContent = (error && error.message)
              ? error.message
              : 'The scan could not be completed. Please try again.';
          })
          .scanDocumentForReferences();

        function onScanned(result) {
          report = result || {};

          if (report.nothingToScan) {
            finish('No text in this document looks like a Sefaria reference, so nothing was sent to Sefaria.\n\nIf you expected a match, switch "Document scanning" to "Whole document" in Preferences → Linking.');
            return;
          }

          var matches = report.matches || [];
          if (!matches.length) {
            var nothing = 'No new references to link.';
            if (report.unresolvedCount) {
              nothing += '\n\n' + plural(report.unresolvedCount, 'citation') +
                ' looked like a reference but could not be matched to a Sefaria source.';
            }
            if (report.unplaceableCount) {
              nothing += '\n\n' + plural(report.unplaceableCount, 'citation') +
                ' was recognised but fell across a gap in the partial scan. Set "Document scanning" to "Whole document" in Preferences → Linking to catch these.';
            }
            finish(nothing);
            return;
          }

          buildReview(matches);
          showState('review');
        }

        // ---- review ---------------------------------------------------------

        function buildReview(matches) {
          var mode = report.reviewMode || 'summary';
          var ambiguous = matches.filter(function (m) { return m.ambiguous; });
          var confident = matches.filter(function (m) { return !m.ambiguous; });

          byId('review-title').textContent = (mode === 'full')
            ? 'Review ' + plural(matches.length, 'reference')
            : (ambiguous.length ? 'Resolve ' + plural(ambiguous.length, 'ambiguous citation') : 'Ready to link');

          byId('review-helper').textContent =
            'Tick Link to hyperlink the words in your document, and Insert to add the source’s text after them, using your insertion defaults or the settings under Customize this insertion.';

          var summaryParts = [];
          if (mode !== 'full' && confident.length) {
            summaryParts.push(plural(confident.length, 'reference') + ' matched a single source and will be linked.');
          }
          if (ambiguous.length) {
            summaryParts.push(plural(ambiguous.length, 'citation') + ' matched more than one source — choose a source, then tick Link or Insert.');
          }
          if (report.unresolvedCount) {
            summaryParts.push(plural(report.unresolvedCount, 'citation') + ' could not be matched to a Sefaria source and will be left alone.');
          }
          // Kept separate from "unresolved" because the reader can act on this
          // one: the citation was recognised, but the partial scan uploaded it
          // in two pieces, so there is no single span of the document to link.
          if (report.unplaceableCount) {
            summaryParts.push(plural(report.unplaceableCount, 'citation') +
              ' fell across a gap in the partial scan — set "Document scanning" to "Whole document" in Preferences → Linking to catch these.');
          }
          if (summaryParts.length) {
            var summary = byId('summary-line');
            summary.hidden = false;
            summary.textContent = summaryParts.join(' ');
            if (ambiguous.length || report.unresolvedCount) {
              summary.classList.add('has-warning');
            }
          }

          // Ambiguous rows always come first: they are the ones that need a
          // decision. In "full" mode the confident rows follow in the same
          // list. In "summary" mode they sit in a collapsed group — still
          // linked by default, but one click away so Insert can be ticked.
          var tbody = byId('matches-tbody');
          var confidentBody = (mode === 'full' || !ambiguous.length) ? tbody : byId('confident-tbody');
          ambiguous.forEach(function (match) { tbody.appendChild(buildRow(match)); });
          confident.forEach(function (match) { confidentBody.appendChild(buildRow(match)); });

          if (confidentBody !== tbody && confident.length) {
            setupConfidentGroup(confident.length);
          }

          syncMasterCheckboxes();
          updateSelectionCount();
        }

        function setupConfidentGroup(count) {
          var group = byId('confident-tbody');
          var button = byId('group-toggle-btn');
          byId('group-toggle-tbody').hidden = false;

          function render(expanded) {
            group.hidden = !expanded;
            button.setAttribute('aria-expanded', expanded ? 'true' : 'false');
            button.textContent = (expanded ? '▾ Hide ' : '▸ Show ') +
              plural(count, 'reference') + ' that matched a single source';
          }
          button.addEventListener('click', function () { render(group.hidden); });
          render(false);
        }

        function makeCheckbox(className, checked, label) {
          var cb = document.createElement('input');
          cb.type = 'checkbox';
          cb.className = className;
          cb.checked = checked;
          cb.setAttribute('aria-label', label);
          cb.addEventListener('change', function () {
            syncMasterCheckboxes();
            updateSelectionCount();
          });
          return cb;
        }

        function buildRow(match) {
          var tr = document.createElement('tr');
          if (match.ambiguous) tr.className = 'is-ambiguous';

          // Columns 1 and 2 — link it, insert it, or both. An ambiguous row
          // starts with neither: nobody has chosen a source yet, and
          // pre-checking a guess is the behaviour this dialog exists to replace.
          // Insert always starts unchecked; it adds text to the document, so it
          // is only ever done on request.
          var linkCb = makeCheckbox('link-cb', !match.ambiguous, 'Link "' + match.documentText + '"');
          var insertCb = makeCheckbox('insert-cb', false, 'Insert the source for "' + match.documentText + '"');
          [linkCb, insertCb].forEach(function (cb) {
            var td = document.createElement('td');
            td.className = 'cb-cell';
            td.appendChild(cb);
            tr.appendChild(td);
          });

          // Column 3 — the words in the document that become the hyperlink.
          var tdText = document.createElement('td');
          var strong = document.createElement('span');
          strong.className = 'doc-text';
          strong.textContent = match.documentText;
          tdText.appendChild(strong);
          var snippet = document.createElement('span');
          snippet.className = 'snippet';
          snippet.textContent = match.snippet;
          tdText.appendChild(snippet);
          tr.appendChild(tdText);

          // Column 4 — where it points. A dropdown whenever there is a choice.
          var tdRef = document.createElement('td');
          tdRef.className = 'ref-cell';
          var select = null;
          var preview = document.createElement('span');
          preview.className = 'preview';

          if (match.ambiguous) {
            var tag = document.createElement('span');
            tag.className = 'ambiguous-tag';
            tag.textContent = plural(match.candidates.length, 'possible source');
            tdRef.appendChild(tag);

            select = document.createElement('select');
            select.className = 'ref-select';
            select.setAttribute('aria-label', 'Source for "' + match.documentText + '"');
            match.candidates.forEach(function (candidate, index) {
              var option = document.createElement('option');
              option.value = String(index);
              option.textContent = candidate.ref;
              select.appendChild(option);
            });
            select.addEventListener('change', function () {
              renderPreview(preview, match.candidates[parseInt(select.value, 10)]);
              // Choosing a destination is the decision; opt the row in to
              // linking unless the reader has already said what they want.
              if (!linkCb.checked && !insertCb.checked) linkCb.checked = true;
              syncMasterCheckboxes();
              updateSelectionCount();
            });
            tdRef.appendChild(select);
          } else {
            var single = document.createElement('span');
            single.className = 'single-ref';
            single.textContent = match.candidates[0].ref;
            tdRef.appendChild(single);
          }

          tdRef.appendChild(preview);
          renderPreview(preview, match.candidates[0]);
          tr.appendChild(tdRef);

          rows.push({ match: match, linkCb: linkCb, insertCb: insertCb, select: select });
          return tr;
        }

        function renderPreview(node, candidate) {
          if (!candidate) { node.textContent = ''; return; }
          var parts = [];
          if (candidate.heRef) parts.push(candidate.heRef);
          if (candidate.preview) parts.push(candidate.preview);
          node.textContent = parts.join(' — ');
        }

        function countChecked(key) {
          return rows.filter(function (row) { return row[key].checked; }).length;
        }

        function updateSelectionCount() {
          var toLink = countChecked('linkCb');
          var toInsert = countChecked('insertCb');

          byId('selection-count').textContent =
            toLink + ' of ' + rows.length + ' to link · ' + toInsert + ' to insert';

          var label = [];
          if (toLink) label.push('Link ' + toLink);
          if (toInsert) label.push((toLink ? 'insert ' : 'Insert ') + toInsert);
          byId('apply-btn').disabled = !toLink && !toInsert;
          byId('apply-btn').textContent = label.length ? label.join(' & ') : 'Apply';
        }

        function syncMasterCheckboxes() {
          [['linkCb', 'master-link-cb'], ['insertCb', 'master-insert-cb']].forEach(function (pair) {
            var checked = countChecked(pair[0]);
            var master = byId(pair[1]);
            master.checked = rows.length > 0 && checked === rows.length;
            master.indeterminate = checked > 0 && checked < rows.length;
          });
        }

        function setColumn(key, checked) {
          rows.forEach(function (row) { row[key].checked = checked; });
          syncMasterCheckboxes();
          updateSelectionCount();
        }

        byId('master-link-cb').addEventListener('change', function () { setColumn('linkCb', this.checked); });
        byId('master-insert-cb').addEventListener('change', function () { setColumn('insertCb', this.checked); });
        byId('cancel-btn').addEventListener('click', function () { google.script.host.close(); });
        byId('done-close-btn').addEventListener('click', function () { google.script.host.close(); });

        // ---- apply ----------------------------------------------------------

        function decisionFor(row) {
          var index = row.select ? parseInt(row.select.value, 10) : 0;
          var candidate = row.match.candidates[index] || row.match.candidates[0];
          // documentText + occurrence let the server re-find the citation in
          // the document as it is at Apply time, in case it was edited while
          // this dialog was open.
          return {
            startChar: row.match.startChar,
            endChar: row.match.endChar,
            documentText: row.match.documentText,
            occurrence: row.match.occurrence,
            ref: candidate.ref
          };
        }

        byId('apply-btn').addEventListener('click', function () {
          var toLink = rows.filter(function (row) { return row.linkCb.checked; }).map(decisionFor);
          var toInsert = rows.filter(function (row) { return row.insertCb.checked; }).map(decisionFor);

          if (!toLink.length && !toInsert.length) {
            google.script.host.close();
            return;
          }

          showState('applying');

          if (!toLink.length) {
            insertSources(toInsert, 0, 0);
            return;
          }

          byId('apply-label').textContent = 'Linking ' + plural(toLink.length, 'reference') + '…';
          byId('apply-fill').style.width = '35%';

          google.script.run
            .withSuccessHandler(function (result) {
              var linked = (result && result.linked) || 0;
              var skipped = (result && result.skipped) || 0;
              missingCount = (result && result.missing) || 0;
              if (toInsert.length) {
                insertSources(toInsert, linked, skipped);
                return;
              }
              byId('apply-fill').style.width = '100%';
              finish(buildDoneMessage(linked, skipped, 0, 0));
            })
            .withFailureHandler(function (error) {
              finish((error && error.message) || 'The links could not be applied.');
            })
            .applyLinkerDecisions(JSON.stringify(toLink));
        });

        // Insertion is done one source at a time so the reader sees it advance;
        // end-to-start so an earlier insertion cannot shift a later position.
        function insertSources(chosen, linked, skipped) {
          var queue = chosen.slice().sort(function (a, b) { return b.startChar - a.startChar; });
          var total = queue.length;
          var inserted = 0;
          var failed = 0;
          var moved = 0;
          // Fixed for the whole pass, whatever happens to the panel meanwhile.
          var overrides = changedInsertPrefs();

          function step(index) {
            if (index >= queue.length) {
              missingCount = Math.max(missingCount, moved);
              finish(buildDoneMessage(linked, skipped, inserted, failed));
              return;
            }
            var item = queue[index];
            byId('apply-label').textContent = 'Inserting ' + item.ref + '…';
            byId('apply-detail').textContent = (index + 1) + ' of ' + total;
            byId('apply-fill').style.width = Math.round((index / total) * 100) + '%';

            google.script.run
              .withSuccessHandler(function (result) {
                if (result && result.success) inserted++;
                else if (result && result.reason === 'moved') moved++;
                else failed++;
                addNotice(result && result.notice);
                step(index + 1);
              })
              .withFailureHandler(function (error) {
                failed++;
                // Name the source: a bare error message does not say which
                // insert failed, or that the others went ahead.
                addNotice('Could not insert ' + item.ref + ': ' +
                  ((error && error.message) || 'unknown error') +
                  '. Anything already inserted for it may be incomplete.');
                step(index + 1);
              })
              .insertLinkedSourceAtPosition(item.ref, item, overrides);
          }

          step(0);
        }

        function buildDoneMessage(linked, skipped, inserted, failed) {
          var lines = [];
          if (linked || skipped) lines.push('Linked ' + plural(linked, 'reference') + ' to Sefaria.');
          if (inserted) lines.push('Inserted ' + plural(inserted, 'source') + '.');
          if (failed) lines.push(plural(failed, 'source') + ' could not be inserted.');
          if (skipped) lines.push(plural(skipped, 'reference') + ' could not be linked.');
          if (report && report.unresolvedCount) {
            lines.push(plural(report.unresolvedCount, 'citation') + ' could not be matched to a Sefaria source.');
          }
          if (report && report.unplaceableCount) {
            lines.push(plural(report.unplaceableCount, 'citation') + ' fell across a gap in the partial scan.');
          }
          if (missingCount) {
            lines.push(plural(missingCount, 'citation') + ' changed or disappeared from the document after the scan, so ' +
              (missingCount === 1 ? 'it was' : 'they were') + ' left alone. Run Link Texts again to pick ' +
              (missingCount === 1 ? 'it' : 'them') + ' up.');
          }
          // Why something went somewhere unexpected (below a table), or why an
          // insert failed: once each.
          notices.forEach(function (notice) { lines.push('', notice); });
          return lines.join('\n') || 'Nothing was changed.';
        }

        function finish(message) {
          showState('done');
          byId('done-message').textContent = message;
        }
      }());
    </script>
  </body>
</html>
